<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>لجنة التطوير والجودة | نظام تقييم الأداء</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">
<style>
:root {
  /* الألوان الأساسية المريحة للعين */
  --bg-color: #f8fafc;
  --surface: #ffffff;
  --primary: #2563eb;
  --primary-hover: #1d4ed8;
  --primary-light: #eff6ff;
  
  /* ألوان النصوص */
  --text-main: #1e293b;
  --text-muted: #64748b;
  --text-light: #94a3b8;
  
  /* الحدود والظلال */
  --border-color: #e2e8f0;
  --input-bg: #f1f5f9;
  --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
  --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
  --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -2px rgba(0, 0, 0, 0.02);
}

* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { height: 100%; }

body {
  font-family: 'Tajawal', system-ui, sans-serif;
  background-color: var(--bg-color);
  color: var(--text-main);
  min-height: 100vh;
  padding: 0 16px 80px;
  line-height: 1.7;
}

/* ============ الشريط العلوي ============ */
.topbar {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(255, 255, 255, 0.9);
  border-bottom: 1px solid var(--border-color);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  margin: 0 -16px;
  box-shadow: var(--shadow-sm);
}
.topbar-inner {
  max-width: 940px;
  margin: 0 auto;
  padding: 12px 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}
.topbar-brand { display: flex; align-items: center; gap: 14px; }
.topbar-logo {
  width: 44px; height: 44px; border-radius: 12px;
  display: grid; place-items: center; font-size: 20px; color: var(--primary);
  background: var(--primary-light);
}
.topbar-text h1 {
  font-size: 16px; font-weight: 800; color: var(--text-main);
  letter-spacing: 0; line-height: 1.2; margin: 0;
}
.topbar-text span { font-size: 12px; color: var(--text-muted); font-weight: 500; }
.topbar-tag {
  font-size: 12px; font-weight: 700; color: var(--primary);
  background: var(--primary-light);
  border: 1px solid #bfdbfe;
  padding: 6px 16px; border-radius: 999px; white-space: nowrap;
}

.wrap { max-width: 940px; margin: 0 auto; position: relative; }

/* ============ شاشة الدخول ============ */
.screen { display: none; }
.screen.active { display: block; animation: fadeUp .4s ease-out; }
@keyframes fadeUp { from { opacity: 0; transform: translateY(15px); } to { opacity: 1; transform: none; } }

.login-card {
  max-width: 480px; margin: 8vh auto 0;
  background: var(--surface);
  border: 1px solid var(--border-color);
  border-radius: 20px;
  padding: 48px 36px;
  box-shadow: var(--shadow-lg);
}
.crest {
  width: 70px; height: 70px; margin: 0 auto 20px;
  display: grid; place-items: center;
  border-radius: 18px;
  background: var(--primary-light);
  font-size: 28px;
  color: var(--primary);
}
.login-title {
  text-align: center; font-size: 22px; font-weight: 800;
  color: var(--text-main); margin-bottom: 6px;
}
.login-sub { text-align: center; color: var(--text-muted); font-size: 14px; margin-bottom: 32px; }

/* ============ الحقول ============ */
.field { margin-bottom: 22px; text-align: right; }
.field > label { display: block; font-weight: 700; font-size: 14px; margin-bottom: 8px; color: var(--text-main); }
.field .hint { font-weight: 400; color: var(--text-muted); font-size: 12px; }

input[type="text"], input[type="number"], select, textarea {
  width: 100%; padding: 14px 16px; border-radius: 12px;
  background: var(--input-bg);
  border: 1px solid transparent;
  color: var(--text-main); font-family: inherit; font-size: 15px; outline: none;
  transition: all .2s ease;
}
textarea { min-height: 110px; resize: vertical; line-height: 1.8; }
input::placeholder, textarea::placeholder { color: var(--text-light); }
input:hover, select:hover, textarea:hover { background: #e2e8f0; }
input:focus, select:focus, textarea:focus {
  background: var(--surface);
  border-color: var(--primary);
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
}

/* اختيار الصفة */
.role-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
.role-card {
  position: relative; cursor: pointer;
  border: 1px solid var(--border-color);
  background: var(--surface);
  border-radius: 12px; padding: 16px 12px; text-align: center;
  font-weight: 700; font-size: 14px; color: var(--text-muted);
  transition: all .2s ease;
}
.role-card input { position: absolute; opacity: 0; pointer-events: none; }
.role-card .ic { display: block; font-size: 22px; margin-bottom: 8px; transition: .2s; }
.role-card:hover { border-color: #cbd5e1; background: var(--input-bg); }
.role-card:has(input:checked) {
  background: var(--primary-light);
  border-color: var(--primary);
  color: var(--primary);
}
.role-card:has(input:checked) .ic { transform: scale(1.1); }

/* ============ الأزرار ============ */
.btn {
  width: 100%; padding: 16px; border: none; border-radius: 12px; cursor: pointer;
  font-family: inherit; font-size: 16px; font-weight: 700;
  background: var(--primary);
  color: #ffffff;
  box-shadow: var(--shadow-md);
  transition: all .2s ease;
}
.btn:hover { background: var(--primary-hover); transform: translateY(-2px); box-shadow: var(--shadow-lg); }
.btn:active { transform: translateY(0); }
.btn-ghost {
  background: var(--input-bg); color: var(--text-main);
  border: 1px solid transparent; box-shadow: none; width: auto; padding: 12px 24px; font-size: 14px;
}
.btn-ghost:hover { background: #e2e8f0; transform: none; }
.btn-sm { padding: 8px 16px; font-size: 13px; border-radius: 8px; }

/* ============ الهيدر ============ */
.hero { text-align: center; padding: 40px 12px 20px; position: relative; }
.hero-badge {
  width: 60px; height: 60px; margin: 0 auto 16px; display: grid; place-items: center;
  border-radius: 50%;
  background: var(--primary-light);
  color: var(--primary); font-size: 24px;
}
.hero-title {
  font-size: clamp(24px, 4vw, 36px);
  font-weight: 800; line-height: 1.4;
  color: var(--text-main);
}
.hero-sub { margin-top: 8px; color: var(--text-muted); font-size: 15px; }

/* شريط المستخدم */
.userbar {
  display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; align-items: center;
  background: var(--surface); border: 1px solid var(--border-color); border-radius: 16px;
  padding: 16px 20px; margin: 0 0 32px; box-shadow: var(--shadow-sm);
}
.userbar .pill {
  display: flex; align-items: center; gap: 8px;
  background: var(--input-bg); border: 1px solid transparent;
  border-radius: 999px; padding: 6px 16px; font-size: 14px; color: var(--text-muted);
}
.userbar .pill b { color: var(--text-main); font-weight: 700; }

/* ============ البطاقات ============ */
.notice {
  display: flex; gap: 16px; align-items: flex-start;
  background: var(--primary-light);
  border: 1px solid #bfdbfe; border-radius: 16px; padding: 20px; margin-bottom: 32px;
  font-size: 14px; color: #1e3a8a; line-height: 1.8;
}
.notice .ic { font-size: 22px; line-height: 1; }

.card {
  background: var(--surface); border: 1px solid var(--border-color); border-radius: 16px;
  padding: 32px; margin-bottom: 24px;
  box-shadow: var(--shadow-md);
}
.card-head { display: flex; align-items: center; gap: 16px; margin-bottom: 20px; }
.num {
  flex: 0 0 auto; width: 44px; height: 44px; border-radius: 12px;
  display: grid; place-items: center; font-weight: 800; font-size: 18px;
  background: var(--input-bg); color: var(--primary);
}
.card-head h2 { font-size: 18px; font-weight: 800; color: var(--text-main); }
.card-head .sub { font-size: 13.5px; color: var(--text-muted); font-weight: 500; margin-top: 4px; }
.question { font-size: 15px; color: var(--text-main); margin-bottom: 20px; line-height: 1.9; font-weight: 500; }

/* مقياس 1-10 */
.scale { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 20px; }
.chip input { display: none; }
.chip span {
  display: grid; place-items: center; width: 44px; height: 44px; border-radius: 10px;
  background: var(--input-bg); border: 1px solid transparent;
  color: var(--text-muted); font-weight: 700; font-size: 15px; cursor: pointer; transition: all .2s;
}
.chip span:hover { background: #e2e8f0; color: var(--text-main); }
.chip input:checked + span {
  background: var(--primary); color: #ffffff;
  box-shadow: 0 4px 10px rgba(37, 99, 235, 0.3); transform: translateY(-2px);
}
.scale-legend { display: flex; justify-content: space-between; font-size: 12px; color: var(--text-muted); margin: -10px 0 20px; font-weight: 500; }

/* صفوف الأشخاص */
.person-head, .person-row { display: grid; grid-template-columns: 2fr 1fr 2fr 44px; gap: 12px; align-items: center; }
.person-head { font-size: 13px; font-weight: 700; color: var(--text-muted); padding: 0 8px 12px; border-bottom: 1px solid var(--border-color); margin-bottom: 16px; }
.person-row { margin-bottom: 12px; animation: fadeUp .3s ease; }
.person-row select { padding: 14px 8px; text-align: center; }
.remove-btn {
  width: 44px; height: 44px; border-radius: 10px; cursor: pointer;
  background: #fee2e2; border: 1px solid transparent;
  color: #ef4444; font-size: 18px; transition: .2s; font-family: inherit; display: grid; place-items: center;
}
.remove-btn:hover { background: #fca5a5; color: #b91c1c; }
.empty-hint { color: var(--text-light); font-size: 14px; text-align: center; padding: 20px; border: 1px dashed #cbd5e1; border-radius: 12px; background: #f8fafc; }

.actions { display: flex; gap: 16px; flex-wrap: wrap; justify-content: center; margin-top: 40px; }
.actions .btn { width: auto; min-width: 260px; padding: 16px 40px; font-size: 16px; }

/* النجاح */
.success {
  max-width: 520px; margin: 12vh auto 0; text-align: center;
  background: var(--surface); border: 1px solid var(--border-color); border-radius: 20px; padding: 56px 36px;
  box-shadow: var(--shadow-lg);
}
.success .check {
  width: 80px; height: 80px; margin: 0 auto 24px; border-radius: 50%;
  display: grid; place-items: center; font-size: 40px; color: #ffffff;
  background: #10b981; box-shadow: 0 10px 25px rgba(16, 185, 129, 0.3);
  animation: pop .5s cubic-bezier(0.34, 1.56, 0.64, 1);
}
@keyframes pop { from { transform: scale(0.3); opacity: 0; } to { transform: scale(1); opacity: 1; } }
.success h2 { font-size: 24px; font-weight: 800; margin-bottom: 12px; color: var(--text-main); }
.success p { color: var(--text-muted); font-size: 15px; margin-bottom: 32px; line-height: 1.8; }

.loader {
  display: none; width: 18px; height: 18px; border-radius: 50%;
  border: 2px solid rgba(255,255,255,0.3); border-top-color: #ffffff;
  animation: spin .8s linear infinite; vertical-align: -3px; margin-right: 8px;
}
@keyframes spin { to { transform: rotate(360deg); } }
.btn.loading .loader { display: inline-block; }

@media(max-width: 768px) {
  body { padding: 0 12px 40px; }
  .topbar { margin: 0 -12px; }
  .login-card { padding: 32px 20px; margin-top: 4vh; }
  .card { padding: 20px 16px; border-radius: 16px; }
  .person-head { display: none; }
  .person-row { grid-template-columns: 1fr 1fr; gap: 10px; background: var(--bg-color); padding: 16px; border-radius: 12px; border: 1px solid var(--border-color); }
  .person-row .p-name { grid-column: 1 / -1; }
  .person-row .remove-btn { grid-column: 2; justify-self: end; width: 100%; height: 44px; }
  .actions .btn { min-width: 100%; }
  .chip span { width: 40px; height: 40px; font-size: 14px; }
}
</style>
</head>
<body>

<!-- ================= الشريط العلوي ================= -->
<header class="topbar">
  <div class="topbar-inner">
    <div class="topbar-brand">
      <div class="topbar-logo">📑</div>
      <div class="topbar-text">
        <h1>لجنة التطوير والجودة</h1>
        <span>نظام تقييم الأداء</span>
      </div>
    </div>
    <div class="topbar-actions">
      <span class="topbar-tag">سري ومغلق</span>
    </div>
  </div>
</header>

<div class="wrap">

  <!-- ================= شاشة الدخول ================= -->
  <section class="screen active" id="loginScreen">
    <div class="login-card">
      <div class="crest">📊</div>
      <h1 class="login-title">بوابة التقييم</h1>
      <p class="login-sub">لجنة التطوير والجودة</p>

      <div class="field">
        <label for="userName">الاسم <span class="hint">(الاسم الثلاثي)</span></label>
        <input type="text" id="userName" placeholder="اكتب اسمك هنا..." autocomplete="name">
      </div>

      <div class="field">
        <label>الصفة</label>
        <div class="role-grid">
          <label class="role-card">
            <input type="radio" name="role" value="عضو جودة">
            <span class="ic">👤</span>عضو جودة
          </label>
          <label class="role-card">
            <input type="radio" name="role" value="قائد لجنة">
            <span class="ic">⭐</span>قائد لجنة
          </label>
        </div>
      </div>

      <div class="field">
        <label for="committee">اللجنة</label>
        <select id="committee">
          <option value="">— اختر اللجنة —</option>
          <option value="لجنة الجودة والتطوير">لجنة الجودة والتطوير</option>
          <option value="لجنة أخرى">لجنة أخرى</option>
        </select>
      </div>

      <button class="btn" id="enterBtn">بدء التقييم</button>
    </div>
  </section>

  <!-- ================= شاشة التقييم ================= -->
  <section class="screen" id="formScreen">

    <header class="hero">
      <div class="hero-badge">📋</div>
      <h1 class="hero-title">نموذج تقييم الأداء</h1>
      <p class="hero-sub">تقرير تقييم أداء لجنة التطوير والجودة</p>
    </header>

    <div class="userbar">
      <div class="pill">👤 <b id="barName">—</b></div>
      <div class="pill">⭐ <b id="barRole">—</b></div>
      <div class="pill">🏛 <b id="barCommittee">—</b></div>
      <button class="btn btn-ghost btn-sm" id="logoutBtn">تغيير المستخدم</button>
    </div>

    <div class="notice">
      <span class="ic">🔒</span>
      <div>
        يهدف هذا التقرير إلى تقييم أداء اللجنة بشكل شامل من خلال رصد آلية العمل، ومستوى الالتزام والإنجاز، وجودة المخرجات، والتواصل والتفاعل.
        <br><b style="color:var(--text-main); margin-top: 4px; display: inline-block;">جميع المعلومات تعامل بسرية تامة ولا تُشارك خارج إطار التطوير.</b>
      </div>
    </div>

    <form id="evalForm" autocomplete="off">

      <!-- 1 -->
      <div class="card">
        <div class="card-head">
          <div class="num">1</div>
          <div>
            <h2>الالتزام</h2>
            <div class="sub">مدى التزام الأعضاء بالمهام والمواعيد</div>
          </div>
        </div>
        <p class="question">كيف تقيم مستوى التزام أعضاء اللجنة بالمهام؟ وهل كان هناك تأخير أو تقصير؟ وضّح مع ذكر أمثلة إن وجدت.</p>
        <div class="scale" data-name="q1"></div>
        <div class="scale-legend"><span>1 = ضعيف جداً</span><span>10 = ممتاز</span></div>
        <div class="field">
          <label>الملاحظات</label>
          <textarea name="q1_notes" placeholder="اكتب ملاحظاتك هنا..."></textarea>
        </div>
      </div>

      <!-- 2 -->
      <div class="card">
        <div class="card-head">
          <div class="num">2</div>
          <div>
            <h2>الإنجاز</h2>
            <div class="sub">نسبة تحقيق المهام والمخرجات</div>
          </div>
        </div>
        <p class="question">إلى أي مدى تم إنجاز المهام والأعمال المطلوبة من اللجنة؟ وهل تم تحقيق المخرجات المطلوبة؟ وضّح مستوى الإنجاز وأبرز ما تم إنجازه.</p>
        <div class="scale" data-name="q2"></div>
        <div class="scale-legend"><span>1 = ضعيف جداً</span><span>10 = ممتاز</span></div>
        <div class="field">
          <label>الملاحظات</label>
          <textarea name="q2_notes" placeholder="اكتب ملاحظاتك هنا..."></textarea>
        </div>
      </div>

      <!-- 3 -->
      <div class="card">
        <div class="card-head">
          <div class="num">3</div>
          <div>
            <h2>جودة المخرجات</h2>
            <div class="sub">الوضوح والدقة ومطابقة المطلوب</div>
          </div>
        </div>
        <p class="question">كيف تقيم جودة الأعمال والمخرجات المقدمة من اللجنة؟ وهل كانت واضحة، دقيقة، ومطابقة للمطلوب؟ وما الجوانب التي يمكن تحسينها إن وجدت؟</p>
        <div class="scale" data-name="q3"></div>
        <div class="scale-legend"><span>1 = ضعيف جداً</span><span>10 = ممتاز</span></div>
        <div class="field">
          <label>الملاحظات</label>
          <textarea name="q3_notes" placeholder="اكتب ملاحظاتك هنا..."></textarea>
        </div>
      </div>

      <!-- 4 -->
      <div class="card">
        <div class="card-head">
          <div class="num">4</div>
          <div>
            <h2>التواصل والتفاعل</h2>
            <div class="sub">سرعة التجاوب ووضوح التعليمات والمتابعة</div>
          </div>
        </div>
        <p class="question">كيف تقيم مستوى التواصل والتفاعل داخل اللجنة؟ من حيث سرعة التجاوب مع الأعضاء، وضوح التعليمات، ومتابعة القادة للمهام.</p>
        <div class="scale" data-name="q4"></div>
        <div class="scale-legend"><span>1 = ضعيف جداً</span><span>10 = ممتاز</span></div>
        <div class="field">
          <label>الملاحظات</label>
          <textarea name="q4_notes" placeholder="اكتب ملاحظاتك هنا..."></textarea>
        </div>
      </div>

      <!-- 5 -->
      <div class="card">
        <div class="card-head">
          <div class="num">5</div>
          <div>
            <h2>التحديات وكيفية التعامل معها</h2>
            <div class="sub">إن وجدت</div>
          </div>
        </div>
        <p class="question">ما أبرز التحديات أو الصعوبات التي واجهتك أو واجهت اللجنة أثناء العمل؟ وكيف تم التعامل معها؟ وهل ترى أن طريقة التعامل معها كانت مناسبة؟</p>
        <div class="field">
          <label>التحديات</label>
          <textarea name="challenges" placeholder="اذكر التحديات..."></textarea>
        </div>
        <div class="field">
          <label>كيفية التعامل معها</label>
          <textarea name="how_handled" placeholder="كيف تم التعامل معها..."></textarea>
        </div>
        <div class="field">
          <label>الحلول</label>
          <textarea name="solutions" placeholder="الحلول المقترحة..."></textarea>
        </div>
      </div>

      <!-- 6 -->
      <div class="card">
        <div class="card-head">
          <div class="num">6</div>
          <div>
            <h2>الحلول والتحسينات</h2>
            <div class="sub">في حال الحاجة إلى التحسين</div>
          </div>
        </div>
        <p class="question">من وجهة نظرك، ما الحلول أو التغييرات التي يمكن تطبيقها لتحسين أداء اللجنة؟ اذكر أي أفكار أو مقترحات تراها مناسبة.</p>
        <div class="field">
          <label>المقترحات</label>
          <textarea name="suggestions" placeholder="اكتب مقترحاتك..."></textarea>
        </div>
      </div>

      <!-- تقييم الأعضاء -->
      <div class="card">
        <div class="card-head">
          <div class="num" style="background:var(--primary); color:#fff;">👥</div>
          <div>
            <h2>تقييم أعضاء اللجنة</h2>
            <div class="sub">الالتزام، التعاون، تحمل المسؤولية، المبادرة، التفاعل</div>
          </div>
        </div>
        <p class="question">كيف تقيم أداء أعضاء اللجنة بشكل عام؟</p>
        <div class="person-head">
          <div>اسم العضو</div>
          <div>التقييم من ١٠</div>
          <div>الملاحظات (إن وجدت)</div>
          <div></div>
        </div>
        <div id="membersList"></div>
        <div id="membersEmpty" class="empty-hint">لم تُضف أي عضو بعد — اضغط «إضافة عضو» بالأسفل</div>
        <div style="margin-top:20px">
          <button type="button" class="btn btn-ghost" id="addMemberBtn">＋ إضافة عضو</button>
        </div>
      </div>

      <!-- تقييم القادة -->
      <div class="card">
        <div class="card-head">
          <div class="num" style="background:var(--primary); color:#fff;">⭐</div>
          <div>
            <h2>تقييم قادة اللجنة</h2>
            <div class="sub">التنظيم، توزيع المهام، المتابعة، التواصل، الدعم، حل المشكلات</div>
          </div>
        </div>
        <p class="question">كيف تقيم أداء قائد اللجنة ونائبه؟</p>
        <div class="person-head">
          <div>اسم القائد / النائب</div>
          <div>التقييم من ١٠</div>
          <div>الملاحظات (إن وجدت)</div>
          <div></div>
        </div>
        <div id="leadersList"></div>
        <div id="leadersEmpty" class="empty-hint">لم تُضف أي قائد بعد — اضغط «إضافة قائد / نائب» بالأسفل</div>
        <div style="margin-top:20px">
          <button type="button" class="btn btn-ghost" id="addLeaderBtn">＋ إضافة قائد / نائب</button>
        </div>
      </div>

      <div class="actions">
        <button type="submit" class="btn" id="submitBtn">
          <span class="loader"></span> إرسال التقرير النهائي
        </button>
      </div>
      <p id="errorMsg" style="display:none;text-align:center;color:#ef4444;font-weight:700;margin-top:20px; font-size: 15px;"></p>
    </form>
  </section>

  <!-- ================= شاشة النجاح ================= -->
  <section class="screen" id="successScreen">
    <div class="success">
      <div class="check">✓</div>
      <h2>تم استلام التقييم بنجاح</h2>
      <p>شكراً لجهودك، تم حفظ إجاباتك في قاعدة البيانات الآمنة وسيتم التعامل معها بسرية تامة لرفع جودة العمل.</p>
      <button class="btn btn-ghost" id="newFormBtn">تعبئة نموذج جديد</button>
    </div>
  </section>

</div>

<script>
/* =======================================================================
   ⚙️  الإعدادات — ضع هنا رابط Google Apps Script بعد النشر
   ======================================================================= */
const SCRIPT_URL = "ضع_رابط_Apps_Script_هنا";

/* ============================ الحالة ============================ */
const state = { name: "", role: "", committee: "" };

/* ======================= أدوات مساعدة ======================= */
const $  = (s, p = document) => p.querySelector(s);
const $$ = (s, p = document) => [...p.querySelectorAll(s)];  function showScreen(id) {   $$(".screen").forEach(s => s.classList.remove("active"));
  $("#" + id).classList.add("active");   window.scrollTo({ top: 0, behavior: "smooth" }); }  /* ======================= بناء مقاييس 1-10 ======================= */ $$(".scale").forEach(box => {
  const name = box.dataset.name;
  for (let i = 1; i <= 10; i++) {
    const label = document.createElement("label");
    label.className = "chip";
    label.innerHTML = `<input type="radio" name="${name}" value="${i}"><span>${i}</span>`;
    box.appendChild(label);
  }
});

/* ======================= صفوف الأشخاص ======================= */
function scoreOptions() {
  let html = '<option value="">—</option>';
  for (let i = 1; i <= 10; i++) html += `<option value="${i}">${i}</option>`;
  return html;
}

function addPersonRow(listEl, emptyEl, namePlaceholder) {
  emptyEl.style.display = "none";
  const row = document.createElement("div");
  row.className = "person-row";
  row.innerHTML = `
    <input type="text" class="p-name" placeholder="${namePlaceholder}">
    <select class="p-score">${scoreOptions()}</select>
    <input type="text" class="p-note" placeholder="ملاحظات (إن وجدت)">
    <button type="button" class="remove-btn" title="حذف">✕</button>`;
  row.querySelector(".remove-btn").onclick = () => {
    row.remove();
    if (!listEl.children.length) emptyEl.style.display = "block";
  };
  listEl.appendChild(row);
  row.querySelector(".p-name").focus();
}

$("#addMemberBtn").onclick = () =>
  addPersonRow($("#membersList"), $("#membersEmpty"), "اسم العضو");

$("#addLeaderBtn").onclick = () =>
  addPersonRow($("#leadersList"), $("#leadersEmpty"), "اسم القائد / النائب");

/* ======================= شاشة الدخول ======================= */
$("#enterBtn").onclick = () => {
  const name = $("#userName").value.trim();
  const role = $('input[name="role"]:checked')?.value || "";
  const committee = $("#committee").value;

  if (!name)                return alert("الرجاء إدخال الاسم الثلاثي للمتابعة");
  if (!role)                return alert("الرجاء تحديد صفتك في اللجنة");
  if (!committee)           return alert("الرجاء اختيار اللجنة الخاصة بك");

  state.name = name;
  state.role = role;
  state.committee = committee;

  $("#barName").textContent = name;
  $("#barRole").textContent = role;
  $("#barCommittee").textContent = committee;

  showScreen("formScreen");
};

$("#logoutBtn").onclick = () => {
  if (confirm("هل أنت متأكد من رغبتك في تسجيل الخروج وإلغاء النموذج الحالي؟")) {
    $("#evalForm").reset();
    $("#membersList").innerHTML = "";
    $("#leadersList").innerHTML = "";
    $("#membersEmpty").style.display = "block";
    $("#leadersEmpty").style.display = "block";     showScreen("loginScreen");   } };  /* ======================= جمع البيانات ======================= */ function collectPeople(listId) {   return $$("#" + listId + " .person-row").map(row => ({
    name:  row.querySelector(".p-name").value.trim(),
    score: row.querySelector(".p-score").value,
    note:  row.querySelector(".p-note").value.trim()
  })).filter(p => p.name || p.score || p.note);
}

/* ======================= الإرسال ======================= */
$("#evalForm").addEventListener("submit", async (e) => {
  e.preventDefault();

  const errEl = $("#errorMsg");
  errEl.style.display = "none";

  const fd = new FormData(e.target);
  const val = n => (fd.get(n) || "").toString().trim();

  if (!val("q1") || !val("q2") || !val("q3") || !val("q4")) {
    errEl.textContent = "الرجاء إكمال التقييم الرقمي للبنود الأربعة الأولى (1 - 4) قبل الإرسال.";
    errEl.style.display = "block";
    errEl.scrollIntoView({ behavior: "smooth", block: "center" });
    return;
  }

  const payload = {
    name:       state.name,
    role:       state.role,
    committee:  state.committee,
    q1: val("q1"), q1_notes: val("q1_notes"),
    q2: val("q2"), q2_notes: val("q2_notes"),
    q3: val("q3"), q3_notes: val("q3_notes"),
    q4: val("q4"), q4_notes: val("q4_notes"),
    challenges:  val("challenges"),
    how_handled: val("how_handled"),
    solutions:   val("solutions"),
    suggestions: val("suggestions"),
    members: collectPeople("membersList"),
    leaders: collectPeople("leadersList")
  };

  const btn = $("#submitBtn");
  btn.classList.add("loading");
  btn.disabled = true;

  try {
    if (SCRIPT_URL.includes("ضع_رابط")) {
      throw new Error("لم يتم ربط الموقع بقاعدة البيانات بعد. الرجاء وضع رابط Apps Script في المتغير SCRIPT_URL.");
    }

    const res = await fetch(SCRIPT_URL, {
      method: "POST",
      headers: { "Content-Type": "text/plain;charset=utf-8" },
      body: JSON.stringify(payload)
    });

    const out = await res.json().catch(() => ({ ok: true }));
    if (out && out.ok === false) throw new Error(out.error || "حدث خطأ أثناء حفظ البيانات");

    showScreen("successScreen");

  } catch (err) {
    errEl.textContent = "⚠️ " + err.message;
    errEl.style.display = "block";
    errEl.scrollIntoView({ behavior: "smooth", block: "center" });
  } finally {
    btn.classList.remove("loading");
    btn.disabled = false;
  }
});

/* ======================= نموذج جديد ======================= */
$("#newFormBtn").onclick = () => {
  $("#evalForm").reset();
  $("#membersList").innerHTML = "";
  $("#leadersList").innerHTML = "";
  $("#membersEmpty").style.display = "block";
  $("#leadersEmpty").style.display = "block";
  showScreen("formScreen");
};
</script>
</body>
</html>
